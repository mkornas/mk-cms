# ── App ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Serve the built admin from the same origin (empty = API only). The Docker
# image sets this to /app/admin.
ADMIN_DIR=

# ── Postgres ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=mkcms
DB_PASSWORD=mkcms
DB_NAME=mkcms
# Auto-run migrations on boot (idempotent). Never enable DB_SYNCHRONIZE outside throwaway dev.
DB_RUN_MIGRATIONS=true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# ── First-run seed (applied only when the DB has no users) ──
SEED_ENABLED=true
SEED_OWNER_EMAIL=owner@mk-cms.local
SEED_OWNER_PASSWORD=changeme123
SEED_OWNER_NAME=Owner
SEED_SITE_SLUG=default
SEED_SITE_NAME=Default Site
# Also import a small fictional demo site (pages, posts, categories) on first boot.
SEED_DEMO=false

# ── Media / storage ─────────────────────────────────
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
MEDIA_PUBLIC_URL=http://localhost:4000
MEDIA_MAX_DOWNLOAD_BYTES=50000000

# ── S3 / MinIO (used when MEDIA_DRIVER=s3) ───────────
# docker compose runs MinIO on 9000/9001 (console); the mkcms-media bucket is
# created public by the minio-setup service.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mkcms-media
S3_ACCESS_KEY=mkcms
S3_SECRET_KEY=mkcms-secret
S3_FORCE_PATH_STYLE=true
# Public base for object URLs (default: ${S3_ENDPOINT}/${S3_BUCKET})
S3_PUBLIC_URL=
